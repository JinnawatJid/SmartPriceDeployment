# Dynamics 365 Business Central Configuration
# CDP_URL is the Chrome DevTools Protocol endpoint
# Use 127.0.0.1 instead of localhost to avoid IPv6 issues
CDP_URL=http://127.0.0.1:9222

# Optional: D365 URL (not needed if connecting to existing tab)
# D365_URL=https://businesscentral.dynamics.com/YOUR_TENANT/YOUR_ENVIRONMENT/?company=YOUR_COMPANY&page=9300

# Optional: Add credentials if needed for authentication
# D365_USERNAME=your_username
# D365_PASSWORD=your_password
